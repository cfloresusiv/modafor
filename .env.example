# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y rellénalo.  NUNCA subas .env a GitHub.
# ─────────────────────────────────────────────────────────────

# Modo de funcionamiento:
#   observar  -> solo muestra lo que hacen las wallets seguidas (no necesita wallet)
#   simular   -> "paper trading": copia con dinero ficticio y calcula ganancias/pérdidas
#   real      -> compra y vende de verdad con tu wallet (¡dinero real!)
MODE=observar

# Wallets a copiar, separadas por comas
WATCH_LIST=WALLET_1,WALLET_2

# Yellowstone gRPC (add-on de QuickNode) – para recibir transacciones en tiempo real
YELLOWSTONE_ENDPOINT=https://tu-endpoint.solana-mainnet.quiknode.pro:10000
YELLOWSTONE_TOKEN=tu_token

# ── Solo necesarios en MODE=real ────────────────────────────
# RPC de Solana (tu endpoint de QuickNode)
SOLANA_RPC=https://tu-endpoint.solana-mainnet.quiknode.pro/tu_token/
# Metis (add-on de QuickNode) – arma la transacción de compra/venta en pump.fun
METIS_ENDPOINT=https://jupiter-swap-api.quiknode.pro/TU_CLAVE
# Clave privada de una wallet NUEVA solo para el bot.
# Acepta el formato de Phantom (base58) o un arreglo JSON [12,34,...]
SECRET_KEY=

# ── Parámetros de copia ────────────────────────────────────
# SOL que gastas en cada compra copiada
BUY_AMOUNT_SOL=0.005
# Ignorar operaciones de la wallet seguida menores a esto (SOL)
MIN_WHALE_SOL=0.1
# Presupuesto máximo total de la sesión (SOL). Al llegar, deja de comprar.
MAX_TOTAL_SOL=0.03
# Máximo de posiciones abiertas al mismo tiempo
MAX_OPEN_POSITIONS=3
# SOL que siempre se deja en la wallet para pagar comisiones
MIN_SOL_RESERVE=0.01
# Deslizamiento máximo aceptado (300 = 3 %)
SLIPPAGE_BPS=300
# Prioridad de la comisión: low | medium | high | extreme
PRIORITY_FEE_LEVEL=high

# ── Solo para MODE=simular ─────────────────────────────────
# Penalización de precio por llegar tarde (5 = pagas 5 % más al comprar y recibes 5 % menos al vender)
SIM_DELAY_PENALTY_PCT=5
# Comisión estimada por operación (red + prioridad), en SOL
SIM_FEE_SOL=0.0002
# Saldo ficticio inicial para la simulación (SOL)
SIM_START_SOL=0.05
